{% comment %}
  Black Friday Banner Section - Collection Pages
  Simplified professional B2B style
{% endcomment %}

{% if section.settings.enable_banner %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500;700&display=swap" rel="stylesheet">

<div id="bf-collection-banner" class="bf-col-banner" data-banner-id="bf-collection-2025">
  <div class="bf-col-container">
    {%- comment -%} Close Button {%- endcomment -%}
    <button class="bf-col-close" aria-label="Close banner">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
        <path d="M15 5L5 15M5 5L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="bf-col-content">
      {%- comment -%} Lightning Icon {%- endcomment -%}
      <div class="bf-col-icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" fill="currentColor"/>
        </svg>
      </div>

      {%- comment -%} Text Content {%- endcomment -%}
      <div class="bf-col-text">
        <span class="bf-col-title">{{ section.settings.banner_title }}</span>
        <span class="bf-col-divider">|</span>
        <span class="bf-col-subtitle">{{ section.settings.banner_subtitle }}</span>
        <span class="bf-col-note">{{ section.settings.banner_note }}</span>
      </div>

      {%- comment -%} Countdown {%- endcomment -%}
      <div class="bf-col-countdown" id="bf-col-countdown">
        <span class="bf-col-countdown-label">Ends in:</span>
        <span class="bf-col-time" id="col-days">00</span>d
        <span class="bf-col-time" id="col-hours">00</span>h
        <span class="bf-col-time" id="col-minutes">00</span>m
        <span class="bf-col-time" id="col-seconds">00</span>s
      </div>
    </div>
  </div>
</div>

<style>
  .bf-col-banner {
    background: linear-gradient(90deg, {{ section.settings.primary_color }} 0%, #8a1519 100%);
    border-top: 2px solid {{ section.settings.secondary_color }};
    border-bottom: 2px solid {{ section.settings.secondary_color }};
    position: relative;
    font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    margin-bottom: 20px;
  }

  .bf-col-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 15px 20px;
    position: relative;
  }

  .bf-col-close {
    position: absolute;
    top: 50%;
    right: 15px;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    color: #fff;
    cursor: pointer;
    padding: 6px;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .bf-col-close:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-50%) rotate(90deg);
  }

  .bf-col-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-right: 40px;
  }

  .bf-col-icon {
    color: #FFD700;
    flex-shrink: 0;
    animation: glow 2s ease-in-out infinite;
  }

  @keyframes glow {
    0%, 100% { filter: drop-shadow(0 0 3px #FFD700); }
    50% { filter: drop-shadow(0 0 8px #FFD700); }
  }

  .bf-col-text {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .bf-col-title {
    font-size: 20px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .bf-col-divider {
    color: rgba(255, 255, 255, 0.4);
    font-size: 18px;
  }

  .bf-col-subtitle {
    font-size: 18px;
    font-weight: 700;
    color: #FFD700;
    letter-spacing: 0.5px;
  }

  .bf-col-note {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
    padding: 4px 12px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bf-col-countdown {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 14px;
    color: #fff;
    font-weight: 500;
  }

  .bf-col-countdown-label {
    margin-right: 4px;
    opacity: 0.9;
  }

  .bf-col-time {
    font-weight: 700;
    color: #FFD700;
    font-variant-numeric: tabular-nums;
    min-width: 20px;
    text-align: center;
  }

  /* Mobile Responsive */
  @media (max-width: 968px) {
    .bf-col-container {
      padding: 12px 15px;
      padding-right: 45px;
    }

    .bf-col-content {
      gap: 12px;
    }

    .bf-col-icon {
      display: none;
    }

    .bf-col-title {
      font-size: 16px;
    }

    .bf-col-subtitle {
      font-size: 15px;
    }

    .bf-col-note {
      font-size: 11px;
      padding: 3px 10px;
    }

    .bf-col-countdown {
      font-size: 12px;
      padding: 6px 12px;
      gap: 6px;
    }
  }

  @media (max-width: 640px) {
    .bf-col-text {
      gap: 8px;
    }

    .bf-col-title {
      font-size: 14px;
      width: 100%;
      text-align: center;
    }

    .bf-col-divider {
      display: none;
    }

    .bf-col-subtitle {
      font-size: 14px;
    }

    .bf-col-note {
      width: 100%;
      text-align: center;
      font-size: 10px;
    }

    .bf-col-countdown {
      width: 100%;
      justify-content: center;
    }
  }

  .bf-col-hidden {
    display: none !important;
  }
</style>

<script>
(function() {
  'use strict';

  const banner = document.getElementById('bf-collection-banner');
  const closeBtn = banner?.querySelector('.bf-col-close');
  const bannerId = banner?.dataset.bannerId;

  // Check if banner was closed in this session
  if (sessionStorage.getItem(bannerId + '_closed') === 'true') {
    banner?.classList.add('bf-col-hidden');
    return;
  }

  // Close button functionality
  closeBtn?.addEventListener('click', function() {
    banner.classList.add('bf-col-hidden');
    sessionStorage.setItem(bannerId + '_closed', 'true');
  });

  // Countdown Timer
  const endDate = new Date('{{ section.settings.end_date }}T23:59:59').getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const distance = endDate - now;

    if (distance < 0) {
      const countdownEl = document.getElementById('bf-col-countdown');
      if (countdownEl) {
        countdownEl.innerHTML = '<span style="color: #FFD700;">Sale Ended</span>';
      }
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    const daysEl = document.getElementById('col-days');
    const hoursEl = document.getElementById('col-hours');
    const minutesEl = document.getElementById('col-minutes');
    const secondsEl = document.getElementById('col-seconds');

    if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
    if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
    if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
    if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
  }

  // Check if event is active
  const startDate = new Date('{{ section.settings.start_date }}T00:00:00').getTime();
  const now = new Date().getTime();

  if (now >= startDate && now <= endDate) {
    updateCountdown();
    setInterval(updateCountdown, 1000);
  } else {
    banner?.classList.add('bf-col-hidden');
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Black Friday Collection Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_banner",
      "label": "Enable Banner",
      "default": true
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner Title",
      "default": "BLACK FRIDAY SALE"
    },
    {
      "type": "text",
      "id": "banner_subtitle",
      "label": "Banner Subtitle",
      "default": "Up to 20% OFF"
    },
    {
      "type": "text",
      "id": "banner_note",
      "label": "Banner Note",
      "default": "For Dealers Only"
    },
    {
      "type": "text",
      "id": "start_date",
      "label": "Start Date (YYYY-MM-DD)",
      "default": "2025-11-07",
      "info": "Format: 2025-11-07"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date (YYYY-MM-DD)",
      "default": "2025-12-01",
      "info": "Format: 2025-12-01"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#ac1d23"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary Color",
      "default": "#a9abb2"
    }
  ],
  "presets": [
    {
      "name": "Black Friday Collection Banner"
    }
  ]
}
{% endschema %}
